DATABASE_URL=your_neon_database_url
ADMIN_PASSWORD=your_secure_admin_password
SESSION_SECRET=your_random_session_secret
# Public site URL for social previews (set to your live domain, e.g. https://www.jacqlaw.com)
NEXT_PUBLIC_SITE_URL=https://www.jacqlaw.com
# Google Analytics measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-M749HMZ9SK
# Bing Webmaster Tools verification code (the content of the msvalidate.01 meta tag)
BING_SITE_VERIFICATION=
# Resend (https://resend.com) — contact and consultation forms email the office
# RESEND_FROM_EMAIL must use a domain you have verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Law Office of Jacquelyn R. Goncalves <notifications@jacqlaw.com>
# Inbox that receives form submissions. Defaults to the office email in site config.
CONTACT_TO_EMAIL=jr@jacquelynrgoncalveslaw.com
